gesture_sounds = {}
for instrument, gestures in SOUND_PATHS.items():
    gesture_sounds[instrument] = {}
    for gesture, (path, note) in gestures.items():
        try:
            gesture_sounds[instrument][gesture] = {
                "sound": pygame.mixer.Sound(path),
                "note": note
            }
        except Exception as e:
            print(f"Error loading {path}: {e}")

def play_sound_limited(sound_obj, duration=3.0):
    channel = sound_obj.play()
    if channel:
        threading.Thread(target=lambda: (time.sleep(duration), channel.stop()), daemon=True).start()

def choose_instrument():
    print("Choose an instrument: [p]iano, [g]uitar, [d]rum")
    while True:
        choice = input("Enter choice (p/g/d): ").lower().strip()
        if choice in ['p', 'g', 'd']:
            return {'p': 'piano', 'g': 'guitar', 'd': 'drum'}[choice]
        print("Invalid choice!")

def get_finger_states(hand_landmarks, label):
    thumb_margin = 0.02
    thumb = (hand_landmarks.landmark[4].x - hand_landmarks.landmark[3].x) > thumb_margin if label == "Right" else (hand_landmarks.landmark[3].x - hand_landmarks.landmark[4].x) > thumb_margin
    return {
        'THUMB': thumb,
        'INDEX': hand_landmarks.landmark[8].y > hand_landmarks.landmark[6].y,
        'MIDDLE': hand_landmarks.landmark[12].y > hand_landmarks.landmark[10].y,
        'RING': hand_landmarks.landmark[16].y > hand_landmarks.landmark[14].y,
        'PINKY': hand_landmarks.landmark[20].y > hand_landmarks.landmark[18].y
    }

def interpret_gesture(finger_states, hand_label):
    prefix = hand_label.upper() + "_"
    fingers = [f for f, down in finger_states.items() if down]
    if not fingers:
        return None
    gesture = prefix + "_".join(fingers) + "_DOWN"
    if len(fingers) == 5:
        gesture = prefix + "ALL_DOWN"
    return gesture

def main():
    mp_hands = mp.solutions.hands
    mp_drawing = mp.solutions.drawing_utils

    instrument = choose_instrument()
    print(f"Starting Gesture Music with {instrument}. Press 'q' to quit.")

    cap = cv2.VideoCapture(0)
    last_time = 0
    cooldown = 0.8

    with mp_hands.Hands(max_num_hands=2, min_detection_confidence=0.5, min_tracking_confidence=0.5) as hands:
        while cap.isOpened():
            ret, frame = cap.read()
            if not ret:
                continue

            frame = cv2.flip(frame, 1)
            img_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            results = hands.process(img_rgb)

            current_time = time.time()
            if results.multi_hand_landmarks and results.multi_handedness:
                gestures_this_frame = []

                for hand_landmarks, handedness in zip(results.multi_hand_landmarks, results.multi_handedness):
                    label = handedness.classification[0].label
                    finger_states = get_finger_states(hand_landmarks, label)
                    gesture = interpret_gesture(finger_states, label)
                    mp_drawing.draw_landmarks(frame, hand_landmarks, mp_hands.HAND_CONNECTIONS)
                    if gesture:
                        gestures_this_frame.append(gesture)

                # --- Play single or combo gestures ---
                for gesture in gestures_this_frame:
                    if gesture in gesture_sounds[instrument] and (current_time - last_time > cooldown):
                        note_info = gesture_sounds[instrument][gesture]
                        play_sound_limited(note_info["sound"])
                        print(f"{instrument.capitalize()} - {gesture} → {note_info['note']}")
                        last_time = current_time

                # --- Two-hand combined gestures ---p

                if len(gestures_this_frame) == 2:
                    combo_name = "BOTH_ALL_DOWN" if all("ALL_DOWN" in g for g in gestures_this_frame) else "BOTH_" + "_".join([f.split("_")[1] for f in gestures_this_frame]) + "_DOWN"
                    if combo_name in gesture_sounds[instrument] and (current_time - last_time > cooldown):
                        note_info = gesture_sounds[instrument][combo_name]
                        play_sound_limited(note_info["sound"])
                        print(f"{instrument.capitalize()} - {combo_name} → {note_info['note']}")
                        last_time = current_time

            cv2.imshow("Gesture Music", frame)
            if cv2.waitKey(5) & 0xFF == ord('q'):
                break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()